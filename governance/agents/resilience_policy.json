{
  "schema_version": 1,
  "baseline_type": "FRAMEWORK_INDEPENDENT_BOUNDED_RESILIENCE",
  "authority": "GITHUB_ONLY",
  "runtime_framework": "NONE",
  "checkpoint": {
    "artifact_scope_only": true,
    "write_after_each_completed_mission": true,
    "definition_fingerprint_required": true,
    "payload_hash_required": true,
    "resume_requires_all_prior_results_pass": true
  },
  "retry": {
    "max_retries_per_mission": 1,
    "retry_only_transient_failure": true,
    "hidden_failure_forbidden": true,
    "failed_attempt_must_be_recorded": true
  },
  "fault_injection": {
    "controlled_only": true,
    "process_interruption_exit_code": 75,
    "transient_failure_is_synthetic": true,
    "scientific_claims_forbidden": true
  },
  "success_criteria": {
    "all_missions_eventually_pass": true,
    "checkpoint_resume_count_min": 1,
    "transient_failure_recovered_count_min": 1,
    "human_interventions": 0,
    "tool_binding_violations": 0,
    "runtime_framework_dependencies": 0,
    "replay_fingerprint_must_match_clean_baseline": true
  }
}
